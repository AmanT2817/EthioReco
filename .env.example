# EthioReco — Environment Variables
# Copy this file to `.env` and fill in the values you need.
# All external API keys are OPTIONAL — the app runs without them and uses sample data only.

# =====================================================
# DATABASE (Required)
# =====================================================
# Development: SQLite (default — file is created on first db:push)
DATABASE_URL="file:/home/z/my-project/db/custom.db"

# Production: Supabase Postgres
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres"

# =====================================================
# AUTH (Required)
# =====================================================
# Used to sign JWT tokens (HMAC-SHA256). Generate a strong random 32+ char string.
# In production, NEVER commit this. Use a secret manager.
JWT_SECRET_KEY="ethioreco-dev-secret-change-me-in-production"

# =====================================================
# APP
# =====================================================
NODE_ENV="development"
# FLASK_ENV equivalent (used only if you split the backend out)
FLASK_ENV="development"

# CORS — comma-separated list of allowed origins (production: your Vercel domain)
CORS_ORIGINS="http://localhost:3000"

# =====================================================
# EXTERNAL APIs (ALL OPTIONAL)
# =====================================================

# TMDB — movies
# Create an account at https://www.themoviedb.org/settings/api
# Use the v4 API Read Access Token (Bearer), NOT the v3 API key
TMDB_API_KEY=""

# Spotify — music
# Create an app at https://developer.spotify.com/dashboard
# Use Client Credentials flow (no user auth needed for catalog search)
SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# Google Books — books
# No API key required for basic search (rate limit: 100 req/min by IP)
# For higher limits, get a key from Google Cloud Console (Books API)
GOOGLE_BOOKS_API_KEY=""

# =====================================================
# SUPABASE (production only — used if you split auth out to Supabase Auth)
# =====================================================
# NEXT_PUBLIC_SUPABASE_URL=""
# NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# NEXT_PUBLIC_SITE_URL="https://your-app.vercel.app"
# NEXT_PUBLIC_API_BASE_URL="https://your-flask-backend.onrender.com"
# SUPABASE_SERVICE_ROLE_KEY=""  # NEVER expose to frontend — backend only
# REDIS_URL=""                  # Render Redis add-on, for caching layer
